# ─────────────────────────────────────────────────────────────
# Apna Store — environment variables
# Copy to .env and fill in. NEVER commit .env.
# See SETUP.md for where to find each value.
# ─────────────────────────────────────────────────────────────

# ── Database (Postgres) ──────────────────────────────────────
# App runtime connection. On Supabase use the *Transaction pooler* (port 6543):
#   Supabase → Project → Connect → "Transaction pooler"
# On a VPS later: postgres://user:pass@localhost:5432/apnastore
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Migrations connection (drizzle-kit). On Supabase use the *Session pooler* (port 5432).
# On a VPS this is usually the same as DATABASE_URL.
DATABASE_URL_DIRECT="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# TLS to the database: require (default — Supabase) | disable (Postgres on the same machine, e.g. the VPS)
# DB_SSL="require"

# ── Object storage (Cloudflare R2, S3-compatible) ────────────
# Cloudflare dashboard → R2 → Manage API tokens → Create token (Object Read & Write)
S3_ENDPOINT="https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
S3_BUCKET="apna-store-media"
# Public URL that serves the bucket: the r2.dev URL or a custom domain
# (e.g. https://media.apnastore.in). No trailing slash.
S3_PUBLIC_URL="https://pub-XXXXXXXXXXXXXXXX.r2.dev"

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Security ──
# Client IP for rate limiting. Leave empty on Vercel/Netlify (detected automatically).
# On a VPS behind nginx: CLIENT_IP_HEADER="x-real-ip" with `proxy_set_header X-Real-IP $remote_addr;`
CLIENT_IP_HEADER=""
# Secret for the full /api/health check (send it as the x-health-token header). Any long random string.
HEALTH_TOKEN=""

# ── E2E tests (admin account used by e2e/*.mjs) ──
E2E_USER="your-admin-username"
E2E_PASS="your-admin-password"

# ── Realtime admin notifications (Supabase Realtime) ──
# Supabase dashboard → Project Settings → API Keys → Publishable key (NOT the secret key).
# Both are public (sent to the browser).
# Leave empty to fall back to checking every 20 seconds.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Phone notifications for the admin (web push) ──
# Generate once with: npx web-push generate-vapid-keys   (the private key is a secret)
# Never change them once in use: every phone would have to turn notifications on again.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
